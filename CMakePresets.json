{
  "version": 6,
  "configurePresets": [
    {
      "name": "strict",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/strict",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/LLVM19.cmake",
        "DSP56300_SANITIZER": "address-undefined"
      }
    },
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/LLVM19.cmake",
        "DSP56300_SANITIZER": "none"
      }
    },
    {
      "name": "thread",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/thread",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/LLVM19.cmake",
        "DSP56300_SANITIZER": "thread"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "strict",
      "configurePreset": "strict",
      "jobs": 4
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 4
    },
    {
      "name": "thread",
      "configurePreset": "thread",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "strict",
      "configurePreset": "strict",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "thread",
      "configurePreset": "thread",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
